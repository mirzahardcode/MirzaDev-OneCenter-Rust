export global Theme {
    out property <color> background: #101116;
    out property <color> surface: #1b1d25;
    out property <color> surface-raised: #242731;
    out property <color> foreground: #f3f2f7;
    out property <color> muted: #a4a5b1;
    out property <color> accent: #c3a5ff;
    out property <color> border: #383a46;
    out property <color> success: #34c759;
    out property <color> error: #ff453a;
}
